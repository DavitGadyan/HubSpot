# --- Site ---
NEXT_PUBLIC_SITE_NAME="Gadyan AI Ops"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BOOKING_URL=            # Cal.com / HubSpot meetings link for "Book a call"
NEXT_PUBLIC_CONTACT_EMAIL=          # fallback mailto when no booking URL
SHOW_DRAFTS=                        # "true" to show draft case studies (default: shown in dev, hidden in prod)

# --- Claude (optimization plan). Without a key, a deterministic rubric-based plan is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database (Supabase Postgres). Without it, local dev stores data in .data/db.json ---
DATABASE_URL=                       # use the transaction pooler URL (port 6543)

# --- HubSpot public app (live portal scan) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/oauth/callback
TOKEN_ENC_KEY=                      # any long random string: openssl rand -base64 32

# --- Email (optional) ---
RESEND_API_KEY=
EMAIL_FROM="Gadyan AI Ops <audit@yourdomain.com>"

# --- Admin (/admin, HTTP basic auth; any username) ---
ADMIN_PASSWORD=
